[Unit]
Description=ATLAS authenticated Ollama API
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=atlas-api
Group=atlas-api
WorkingDirectory=/opt/atlas-api
EnvironmentFile=/etc/atlas-api.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/atlas-api/atlas_api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atlas-api

[Install]
WantedBy=multi-user.target
